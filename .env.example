# Copy to .env and fill in. .env is gitignored.

# Required for the ingestion pipeline (vision transcription of pages the PDF's
# text layer can't provide). Not needed to search an already-extracted contract.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model used for page transcription. Default: claude-sonnet-5
#PWA_MODEL=claude-sonnet-5

# Optional: where the PDFs and extracted text live. Default: ./data
#PWA_DATA_DIR=/path/to/pwa-data
